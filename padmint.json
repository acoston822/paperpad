{
  "schema_version": 1,
  "id": "paperpad",
  "name": "PaperPad",
  "game": "Paper Mario (N64, US 1.0) via Harbour Masters' PaperBoat",
  "kind": "disc-translation",
  "status": "draft-untested",
  "inputs": [
    {
      "type": "n64-rom",
      "formats": [
        "z64",
        "v64",
        "n64"
      ],
      "when": "in-app",
      "description": "Your own unmodified Paper Mario (USA) 1.0 ROM, chosen in the app after installation; the app extracts it privately. The build does not read it."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental"
      },
      "output": "ipa",
      "check": "ipa",
      "steps": [
        {
          "stage": "preflight",
          "command": [
            "{repo}/scripts/check-repo-safety.sh"
          ]
        },
        {
          "stage": "build",
          "command": [
            "{repo}/scripts/build-paperboat.sh",
            "device"
          ]
        },
        {
          "stage": "package",
          "command": [
            "python3",
            "{repo}/scripts/package-paperboat.py",
            "{output}"
          ]
        }
      ]
    },
    "macos": {
      "hosts": {
        "macos-arm64": "planned"
      }
    }
  },
  "requirements": {
    "disk_gb": 15,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "note": "Install Xcode and its iOS platform"
      }
    ]
  },
  "notes": "Builds PaperPad (PaperBoat engine, bundle com.chrissotraidis.paperpad.boat, iOS 16.3+). PaperPad Original (ReCut) stays buildable by hand with scripts/build-ios-device.sh --rom; it has separate saves.",
  "publication": {
    "public_binaries": false,
    "reason": "Recipe only: the app is compiled from the Paper Mario decompilation, so each player builds their own."
  }
}
