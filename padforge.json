{
  "schema_version": 1,
  "id": "paperpad",
  "name": "PaperPad",
  "game": "Paper Mario (N64, US 1.0) via static recompilation",
  "kind": "disc-translation",
  "status": "draft-untested",
  "inputs": [
    {
      "type": "n64-rom",
      "formats": [
        "z64",
        "v64",
        "n64"
      ],
      "when": "build",
      "description": "Your own Paper Mario (USA) 1.0 ROM (SHA-1 3837f44cda784b466c9a2d99df70d77c322b97a0 once normalized), prepared and translated privately during the build."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental"
      },
      "output": "ipa",
      "check": "ipa",
      "steps": [
        {
          "stage": "preflight",
          "command": [
            "{repo}/scripts/check-repo-safety.sh"
          ]
        },
        {
          "stage": "build",
          "command": [
            "{repo}/scripts/build-ios-device.sh",
            "--rom",
            "{disc}"
          ]
        },
        {
          "stage": "package",
          "command": [
            "/usr/bin/env",
            "PAPERPAD_UNSIGNED_IPA_OUTPUT={output}",
            "{repo}/scripts/package-unsigned-ipa.sh"
          ]
        }
      ]
    },
    "macos": {
      "hosts": {
        "macos-arm64": "planned"
      }
    }
  },
  "requirements": {
    "disk_gb": 25,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "jq",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "make",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "brew",
        "version_args": [
          "--version"
        ],
        "note": "Homebrew: the build installs GCC and Python 3.11 for the decompilation tools"
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "note": "Install Xcode and its iOS platform"
      }
    ]
  },
  "notes": "build-ios-device.sh runs the documented chain (sources, ROM preparation, decompilation, N64Recomp generation, RT64 host tools, unsigned device app); package-unsigned-ipa.sh adds licenses and provenance.",
  "publication": {
    "public_binaries": false,
    "reason": "Personal builds contain game code translated from the player's ROM; public releases are source only."
  }
}
